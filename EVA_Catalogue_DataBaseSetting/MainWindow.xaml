<Window x:Class="EVA_Catalogue_DataBaseSetting.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EVA_Catalogue_DataBaseSetting"
                xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
         xmlns:viewmodel="clr-namespace:EVA_Catalogue_DataBaseSetting"  
  Title="Загрузка каталогов оборудования"
  Width="800"
  Height="340"

  AllowsTransparency="True"
  Background="Transparent"
  FontFamily="{materialDesign:NotoFont}"
  ResizeMode="NoResize"
  TextElement.FontSize="14"
  TextElement.FontWeight="Regular"
  TextOptions.TextFormattingMode="Ideal"
  TextOptions.TextRenderingMode="Auto"
  UseLayoutRounding="True"
  WindowStartupLocation="CenterScreen"
  WindowStyle="None"
  mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary Source="Dictionary.xaml" />
    </Window.Resources>

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>





    <Grid>
        <Border Style="{StaticResource BorderWindow2}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="180" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Заголовок окна -->
                <Grid Grid.Row="0" MouseDown="Window_MouseDown" Background="Transparent">


                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="19"
                               Foreground="Black"
                               Text="Загрузка каталогов оборудования" />

                    <Button Grid.Column="2"
                            Command="{Binding Cancel}"
                            Style="{StaticResource CloseButtonStyle}" />
                </Grid>
                <Grid Grid.Row="1" Margin="8,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="52" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="Gray"
                                CornerRadius="8">
                            <TextBlock Margin="14,0,14,2"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       Foreground="White"
                                       Text="Папка с каталогами оборудования" />
                        </Border>

                        <Grid Grid.Row="1" Margin="0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Height="42"
                                    VerticalAlignment="Center"
                                    Background="White"
                                    BorderBrush="Gray"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <TextBlock Margin="12,0"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Text="{Binding LinkForDB}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding LinkForDB}" />
                            </Border>

                            <Button Grid.Column="2"
                                    Width="190"
                                    Height="42"
                                    Margin="0"
                                    Command="{Binding SaveFolderDialogCommand}"
                                    Style="{StaticResource GeneralButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="19"
                                                             Height="19"
                                                             Margin="0,0,8,0"
                                                             Kind="FolderOutline" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Выбрать папку" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid Grid.Row="2" Margin="8,8,8,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="Black"
                               Text="{Binding CatalogueStatusMessage}" />

                    <Button Grid.Row="1"
                            Width="120"
                            Height="40"
                            Margin="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Command="{Binding Accept}"
                            Style="{StaticResource GeneralButton}"
                            Content="ОК" />
                </Grid>
            </Grid>
        </Border>
        <!-- Resize Borders -->
        <Border x:Name="ResizeTop"
                Height="6"
                Style="{StaticResource ResizeBorders}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Cursor="SizeNS"
                MouseDown="ResizeBorder_MouseDown" />
        <Border x:Name="ResizeBottom"
  Height="6"
  VerticalAlignment="Bottom"
  Style="{StaticResource ResizeBorders}"
  Cursor="SizeNS"
  MouseDown="ResizeBorder_MouseDown" />
        <Border x:Name="ResizeLeft"
                Width="6"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Style="{StaticResource ResizeBorders}"
                Cursor="SizeWE"
                MouseDown="ResizeBorder_MouseDown" />
        <Border x:Name="ResizeRight"
                Width="6"
                Style="{StaticResource ResizeBorders}"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                
                Cursor="SizeWE"
                MouseDown="ResizeBorder_MouseDown" />

        <!-- Resize Corners -->
        <Border x:Name="ResizeTopLeft"
                Width="6"
                Height="6"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Style="{StaticResource ResizeBorders}"
                Cursor="SizeNWSE"
                MouseDown="ResizeBorder_MouseDown" />
        <Border x:Name="ResizeTopRight"
                Width="6"
                Height="6"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Style="{StaticResource ResizeBorders}"
                Cursor="SizeNESW"
                MouseDown="ResizeBorder_MouseDown" />
        <Border x:Name="ResizeBottomLeft"
                Width="6"
                Height="6"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Style="{StaticResource ResizeBorders}"
                Cursor="SizeNESW"
                MouseDown="ResizeBorder_MouseDown" />
        <Border x:Name="ResizeBottomRight"
                Width="6"
                Height="6"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Style="{StaticResource ResizeBorders}"
                Cursor="SizeNWSE"
                MouseDown="ResizeBorder_MouseDown" />


    </Grid>

</Window>
