<Window x:Class="EVA_Catalogue_DataBaseSetting.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EVA_Catalogue_DataBaseSetting"
                xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
         xmlns:viewmodel="clr-namespace:EVA_Catalogue_DataBaseSetting"  
  Title="Настройка каталогов"
  Width="800"
  Height="200"

  AllowsTransparency="True"
  Background="Transparent"
  FontFamily="{materialDesign:NotoFont}"
  ResizeMode="NoResize"
  TextElement.FontSize="14"
  TextElement.FontWeight="Regular"
  TextOptions.TextFormattingMode="Ideal"
  TextOptions.TextRenderingMode="Auto"
  UseLayoutRounding="True"
  WindowStartupLocation="CenterScreen"
  WindowStyle="None"
  mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary Source="Dictionary.xaml" />
    </Window.Resources>

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>





    <Grid>
        <Border Style="{StaticResource BorderWindow2}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />

                </Grid.RowDefinitions>

                <!-- Заголовок окна -->
                <Grid Grid.Row="0" MouseDown="Window_MouseDown" Background="Transparent">


                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Grid.ColumnSpan="3"
                               Margin="10 0 0 0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="Black"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <Button Grid.Column="2"
                            Command="{Binding Cancel}"
                            Style="{StaticResource CloseButtonStyle}" />
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35*"/>
                        <ColumnDefinition Width="44*"/>
                    </Grid.ColumnDefinitions>
                    <Button
HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="280"
                            Height="30"
                           Margin="0,0,10,0"
Command="{Binding SaveFolderDialogCommand}" 
Style="{StaticResource GeneralButton}"
Content="Назначить путь к каталогам" Grid.Column="1"/>
                    <TextBlock 
                       Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Margin="20,0,0,0"
                        Width="462"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontSize="16"
                             Text="{Binding LinkForDB}" Height="30"  >

                    </TextBlock>
                </Grid>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="75" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>


                </Grid>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    
                    </Grid.ColumnDefinitions>

                    <Button HorizontalAlignment="Center"
                            Grid.Column="0"
                            Width="130"
                            Height="30"
                            Margin="10,0,0,0"
                            Command="{Binding Accept}"
                            Style="{StaticResource GeneralButton}"
                            Content="Ok" />
                </Grid>
            </Grid>
        </Border>
        <!-- Resize Borders -->
        <Border x:Name="ResizeTop"
                Height="6"
                Style="{StaticResource ResizeBorders}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Cursor="SizeNS"
                MouseDown="ResizeBorder_MouseDown" />
        <Border x:Name="ResizeBottom"
  Height="6"
  VerticalAlignment="Bottom"
  Style="{StaticResource ResizeBorders}"
  Cursor="SizeNS"
  MouseDown="ResizeBorder_MouseDown" />
        <Border x:Name="ResizeLeft"
                Width="6"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Style="{StaticResource ResizeBorders}"
                Cursor="SizeWE"
                MouseDown="ResizeBorder_MouseDown" />
        <Border x:Name="ResizeRight"
                Width="6"
                Style="{StaticResource ResizeBorders}"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                
                Cursor="SizeWE"
                MouseDown="ResizeBorder_MouseDown" />

        <!-- Resize Corners -->
        <Border x:Name="ResizeTopLeft"
                Width="6"
                Height="6"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Style="{StaticResource ResizeBorders}"
                Cursor="SizeNWSE"
                MouseDown="ResizeBorder_MouseDown" />
        <Border x:Name="ResizeTopRight"
                Width="6"
                Height="6"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Style="{StaticResource ResizeBorders}"
                Cursor="SizeNESW"
                MouseDown="ResizeBorder_MouseDown" />
        <Border x:Name="ResizeBottomLeft"
                Width="6"
                Height="6"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Style="{StaticResource ResizeBorders}"
                Cursor="SizeNESW"
                MouseDown="ResizeBorder_MouseDown" />
        <Border x:Name="ResizeBottomRight"
                Width="6"
                Height="6"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Style="{StaticResource ResizeBorders}"
                Cursor="SizeNWSE"
                MouseDown="ResizeBorder_MouseDown" />


    </Grid>

</Window>
