<Window x:Class="EVA_CatalogueManual.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:local="clr-namespace:EVA_CatalogueManual" Title="Ручной подбор оборудования" Width="900" Height="760" MinWidth="850" MinHeight="700" MaxHeight="1000" AllowsTransparency="True" Background="Transparent" FontFamily="{materialDesign:NotoFont}" ResizeMode="CanResize" TextElement.FontSize="14" WindowStartupLocation="CenterScreen" WindowStyle="None">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Dictionary.xaml" /></ResourceDictionary.MergedDictionaries>
    <Style x:Key="ManualLightButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}"><Setter Property="Width" Value="190"/><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="LightGray"/><Setter Property="Foreground" Value="Black"/><Setter Property="BorderBrush" Value="Gray"/><Setter Property="BorderThickness" Value="1"/><Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="5"/></Style>
    <Style x:Key="ManualDarkButton" TargetType="Button" BasedOn="{StaticResource GeneralButton}"><Setter Property="Background" Value="Gray"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="Gray"/><Setter Property="BorderThickness" Value="1"/></Style>
  </ResourceDictionary></Window.Resources>
  <Window.DataContext><local:MainViewModel /></Window.DataContext>
  <Grid><Border Style="{StaticResource BorderWindow2}"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="300"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="62"/><RowDefinition Height="58"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Background="Transparent" MouseDown="Window_MouseDown"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="19" Foreground="Black" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"/><Button Grid.Column="2" Command="{Binding Cancel}" Style="{StaticResource CloseButtonStyle}"/></Grid>
    <Border Grid.Row="1" Padding="0,0,0,12" Style="{StaticResource BorderWindow}"><Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="54"/><RowDefinition Height="36"/><RowDefinition/></Grid.RowDefinitions>
      <Border Grid.Row="0" Margin="0,0,0,8" Background="Gray" Style="{StaticResource BorderWindow}"><TextBlock Margin="12,0" VerticalAlignment="Center" FontSize="16" Foreground="White" Text="Тип оборудования"/></Border>
      <TextBox Grid.Row="1" Margin="12,4" IsReadOnly="True" Style="{StaticResource RoundedTextBoxStyle}" Text="{Binding ChosenTypeOfDevice, UpdateSourceTrigger=PropertyChanged}"/>
      <Grid Grid.Row="2" Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Foreground="Black" Text="Производители"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="Black" Text="Серии"/></Grid>
      <Grid Grid.Row="3" Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <ListBox ItemsSource="{Binding ProducerList}" Style="{StaticResource RoundedListBoxStyle}"><ListBox.ItemTemplate><DataTemplate><CheckBox Margin="4" IsChecked="{Binding IsSelected, Mode=TwoWay}"><TextBlock Text="{Binding producer}"/></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox>
        <ListBox Grid.Column="2" ItemsSource="{Binding SeriesList}" Style="{StaticResource RoundedListBoxStyle}"><ListBox.ItemTemplate><DataTemplate><CheckBox Margin="4" IsChecked="{Binding IsSelected, Mode=TwoWay}"><TextBlock Text="{Binding series}"/></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox>
      </Grid></Grid></Border>
    <Border Grid.Row="3" Padding="0,0,0,12" Style="{StaticResource BorderWindow}"><Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/></Grid.RowDefinitions>
      <Border Margin="0,0,0,8" Background="Gray" Style="{StaticResource BorderWindow}"><TextBlock Margin="12,0" VerticalAlignment="Center" FontSize="16" Foreground="White" Text="Подходящее оборудование"/></Border>
      <Border Grid.Row="1" Margin="12,4,12,0" Padding="3" Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="10"><Grid>
        <DataGrid ItemsSource="{Binding TableOfDevices}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" AutoGenerateColumns="False" HeadersVisibility="Column" ColumnWidth="*" IsReadOnly="True"><DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Focusable" Value="False"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style></DataGrid.ColumnHeaderStyle><DataGrid.Columns><DataGridTextColumn Width="Auto" Header="Производитель" Binding="{Binding [Producer]}"/><DataGridTextColumn Width="Auto" Header="Серия" Binding="{Binding [SeriesName]}"/><DataGridTextColumn Header="Наименование" Binding="{Binding [NameD]}"/><DataGridTextColumn Width="Auto" Header="Марка" Binding="{Binding [Mark]}"/><DataGridTextColumn Width="Auto" Header="Артикул" Binding="{Binding [Code]}"/></DataGrid.Columns></DataGrid>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Text="{Binding DeviceNotFound}"/>
      </Grid></Border></Grid></Border>
    <Grid Grid.Row="4" Margin="0,12,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Grid.Column="0" Width="190" Height="38" Margin="0,0,10,0" Command="{Binding ImportSettingsCommand}" Style="{StaticResource ManualLightButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Width="19" Height="19" Margin="0,0,8,0" Kind="Download"/><TextBlock VerticalAlignment="Center" Text="Импорт настроек"/></StackPanel></Button>
      <Button Grid.Column="1" Width="190" Height="38" Command="{Binding ExportSettingsCommand}" Style="{StaticResource ManualLightButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Width="19" Height="19" Margin="0,0,8,0" Kind="Upload"/><TextBlock VerticalAlignment="Center" Text="Экспорт настроек"/></StackPanel></Button>
      <Button Grid.Column="3" Width="190" Height="38" Margin="0,0,10,0" Command="{Binding ResetConfigurationCommand}" IsEnabled="{Binding CanResetConfiguration}" Style="{StaticResource ManualLightButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Width="19" Height="19" Margin="0,0,8,0" Kind="Restore"/><TextBlock VerticalAlignment="Center" Text="Сбросить выбор"/></StackPanel></Button>
      <Button Grid.Column="4" Width="190" Height="38" Command="{Binding SaveConfigurationCommand}" IsEnabled="{Binding CanSaveConfiguration}" Style="{StaticResource ManualLightButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Width="19" Height="19" Margin="0,0,8,0" Kind="ContentSaveOutline"/><TextBlock VerticalAlignment="Center" Text="Сохранить выбор"/></StackPanel></Button>
    </Grid>
    <Grid Grid.Row="5" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Width="150" Height="40" Command="{Binding Accept}" Style="{StaticResource ManualLightButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Width="19" Height="19" Margin="0,0,8,0" Kind="Close"/><TextBlock VerticalAlignment="Center" Text="Закрыть"/></StackPanel></Button>
      <Button Grid.Column="2" Width="290" Height="40" Command="{Binding EquipmentSelection}" IsEnabled="{Binding IsRowSelected}" Style="{StaticResource ManualDarkButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Width="20" Height="20" Margin="0,0,8,0" Kind="ContentSaveOutline"/><TextBlock VerticalAlignment="Center" Text="Записать данные оборудования"/></StackPanel></Button>
    </Grid>
  </Grid></Border>
  <Border x:Name="ResizeTop" Height="6" VerticalAlignment="Top" Cursor="SizeNS" Style="{StaticResource ResizeBorders}" MouseDown="ResizeBorder_MouseDown"/><Border x:Name="ResizeBottom" Height="6" VerticalAlignment="Bottom" Cursor="SizeNS" Style="{StaticResource ResizeBorders}" MouseDown="ResizeBorder_MouseDown"/><Border x:Name="ResizeLeft" Width="6" HorizontalAlignment="Left" Cursor="SizeWE" Style="{StaticResource ResizeBorders}" MouseDown="ResizeBorder_MouseDown"/><Border x:Name="ResizeRight" Width="6" HorizontalAlignment="Right" Cursor="SizeWE" Style="{StaticResource ResizeBorders}" MouseDown="ResizeBorder_MouseDown"/><Border x:Name="ResizeTopLeft" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Style="{StaticResource ResizeBorders}" MouseDown="ResizeBorder_MouseDown"/><Border x:Name="ResizeTopRight" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Style="{StaticResource ResizeBorders}" MouseDown="ResizeBorder_MouseDown"/><Border x:Name="ResizeBottomLeft" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Style="{StaticResource ResizeBorders}" MouseDown="ResizeBorder_MouseDown"/><Border x:Name="ResizeBottomRight" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Style="{StaticResource ResizeBorders}" MouseDown="ResizeBorder_MouseDown"/>
  </Grid>
</Window>
