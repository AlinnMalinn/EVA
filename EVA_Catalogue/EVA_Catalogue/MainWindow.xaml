<Window x:Class="EVA_Catalogue.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:local="clr-namespace:EVA_Catalogue" Title="Подбор оборудования" Width="600" Height="700" MinWidth="600" MinHeight="700" AllowsTransparency="True" Background="Transparent" FontFamily="{materialDesign:NotoFont}" ResizeMode="CanResize" TextElement.FontSize="14" WindowStartupLocation="CenterScreen" WindowStyle="None">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Dictionary.xaml"/></ResourceDictionary.MergedDictionaries><Style x:Key="AutomaticLightButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}"><Setter Property="Height" Value="34"/><Setter Property="Background" Value="LightGray"/><Setter Property="Foreground" Value="Black"/><Setter Property="BorderBrush" Value="Gray"/><Setter Property="BorderThickness" Value="1"/><Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="5"/></Style><Style x:Key="AutomaticDarkButton" TargetType="Button" BasedOn="{StaticResource GeneralButton}"><Setter Property="Height" Value="34"/><Setter Property="Background" Value="Gray"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="Gray"/><Setter Property="BorderThickness" Value="1"/></Style><Style x:Key="AutomaticIconButton" TargetType="Button" BasedOn="{StaticResource AutomaticLightButton}"><Setter Property="Width" Value="34"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style></ResourceDictionary></Window.Resources>
  <Window.DataContext><local:MainViewModel/></Window.DataContext>
  <Grid><Border Style="{StaticResource BorderWindow2}"><Grid><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="50"/><RowDefinition/><RowDefinition Height="170"/></Grid.RowDefinitions>
    <Grid MouseDown="Window_MouseDown" Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="10,0,0,0" Orientation="Horizontal" VerticalAlignment="Center"><Button Command="{Binding ExportSettingsCommand}" ToolTip="Экспорт настроек" Style="{StaticResource AutomaticIconButton}"><materialDesign:PackIcon Width="18" Height="18" Kind="Upload"/></Button><Button Margin="6,0,0,0" Command="{Binding ImportSettingsCommand}" ToolTip="Импорт настроек" Style="{StaticResource AutomaticIconButton}"><materialDesign:PackIcon Width="18" Height="18" Kind="Download"/></Button><Button Margin="18,0,0,0" Command="{Binding RefreshCataloguesCommand}" ToolTip="Обновить каталоги" Style="{StaticResource AutomaticIconButton}"><materialDesign:PackIcon Width="18" Height="18" Kind="Refresh"/></Button></StackPanel><TextBlock Grid.ColumnSpan="3" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="Black" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"/><Button Grid.Column="2" Command="{Binding Cancel}" Style="{StaticResource CloseButtonStyle}"/></Grid>
    <Grid Grid.Row="1" Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Margin="0,5,5,5" Background="Gray" Style="{StaticResource BorderWindow}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Text="Вкл."/></Border><Border Grid.Column="1" Margin="5,5,0,5" Background="Gray" Style="{StaticResource BorderWindow}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Text="Тип оборудования"/></Border></Grid>
    <Grid Grid.Row="2" Margin="10,0"><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="70"/><RowDefinition Height="70"/><RowDefinition Height="70"/><RowDefinition Height="70"/><RowDefinition Height="70"/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
      <ToggleButton Grid.Row="0" Height="34" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Center" IsThreeState="False" IsChecked="{Binding IsAutomaticSelectionEnabledForModularCircuitBreakers, Mode=TwoWay}"><ToggleButton.IsEnabled><MultiBinding Converter="{StaticResource ButtonToEnabledConverter}"><Binding Path="IsExcelDataAvailable"/></MultiBinding></ToggleButton.IsEnabled></ToggleButton><Button Grid.Row="0" Grid.Column="1" Height="34" Margin="10" VerticalAlignment="Center" Command="{Binding OpenWindowSettingsModularCircuitBreakersCommand}" Content="Модульный автоматический выключатель" Style="{StaticResource TransparentIconButton}"><Button.IsEnabled><MultiBinding Converter="{StaticResource ButtonToEnabledConverter}"><Binding Path="IsExcelDataAvailable"/></MultiBinding></Button.IsEnabled></Button>
      <ToggleButton Grid.Row="1" Height="34" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Center" IsThreeState="False" IsChecked="{Binding IsAutomaticSelectionEnabledForModularResidualCircuitBreakers, Mode=TwoWay}"><ToggleButton.IsEnabled><MultiBinding Converter="{StaticResource ButtonToEnabledConverter}"><Binding Path="IsExcelDataAvailable"/></MultiBinding></ToggleButton.IsEnabled></ToggleButton><Button Grid.Row="1" Grid.Column="1" Height="34" Margin="10" VerticalAlignment="Center" Command="{Binding OpenWindowSettingsModularResidualCurrentBreakersCommand}" Content="Модульный автоматический выключатель дифференциального тока" Style="{StaticResource TransparentIconButton}"><Button.IsEnabled><MultiBinding Converter="{StaticResource ButtonToEnabledConverter}"><Binding Path="IsExcelDataAvailable"/></MultiBinding></Button.IsEnabled></Button>
      <ToggleButton Grid.Row="2" Height="34" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="False"/><Button Grid.Row="2" Grid.Column="1" Height="34" Margin="10" VerticalAlignment="Center" IsEnabled="False" Content="Устройство защитного отключения" Style="{StaticResource TransparentIconButton}"/>
      <ToggleButton Grid.Row="3" Height="34" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="False"/><Button Grid.Row="3" Grid.Column="1" Height="34" Margin="10" VerticalAlignment="Center" IsEnabled="False" Content="Контактор" Style="{StaticResource TransparentIconButton}"/>
      <ToggleButton Grid.Row="4" Height="34" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="False"/><Button Grid.Row="4" Grid.Column="1" Height="34" Margin="10" VerticalAlignment="Center" IsEnabled="False" Content="Предохранитель (плавкая вставка)" Style="{StaticResource TransparentIconButton}"/>
      <ToggleButton Grid.Row="5" Height="34" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="False"/><Button Grid.Row="5" Grid.Column="1" Height="34" Margin="10" VerticalAlignment="Center" IsEnabled="False" Content="Устройство защиты от дугового пробоя" Style="{StaticResource TransparentIconButton}"/>
    </Grid>
    <Border Grid.Row="2" Panel.ZIndex="10" Margin="10" Padding="24" Background="#F5F5F5" BorderBrush="Gray" BorderThickness="1" CornerRadius="8"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsExcelDataAvailable}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="16" Foreground="Black" Text="{Binding CatalogueStatusMessage}"/></Border>
    <Grid Grid.Row="3" Margin="10,0"><Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="55"/><RowDefinition Height="55"/></Grid.RowDefinitions><CheckBox Grid.Row="0" Margin="0,15" HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="{Binding IsExcelDataAvailable}" IsChecked="{Binding IsSelectionForAllPanels, Mode=TwoWay}" Content="Выполнить подбор для всех панелей"/><Button Grid.Row="1" Width="195" HorizontalAlignment="Center" Command="{Binding EquipmentSelection}" Style="{StaticResource AutomaticDarkButton}"><Button.IsEnabled><MultiBinding Converter="{StaticResource ToggleToEnabledConverter}"><Binding Path="IsAutomaticSelectionEnabledForModularResidualCircuitBreakers"/><Binding Path="IsAutomaticSelectionEnabledForModularCircuitBreakers"/><Binding Path="IsExcelDataAvailable"/></MultiBinding></Button.IsEnabled><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Width="18" Height="18" Margin="0,0,7,0" Kind="PlayOutline"/><TextBlock VerticalAlignment="Center" Text="Выполнить подбор"/></StackPanel></Button><Button Grid.Row="2" Width="195" Height="34" HorizontalAlignment="Center" Command="{Binding Accept}" Content="ОК" Style="{StaticResource GeneralButton}"/></Grid>
  </Grid></Border>
  <Border x:Name="ResizeTop" Height="6" VerticalAlignment="Top" Cursor="SizeNS" Style="{StaticResource ResizeBorders}" MouseDown="ResizeBorder_MouseDown"/><Border x:Name="ResizeBottom" Height="6" VerticalAlignment="Bottom" Cursor="SizeNS" Style="{StaticResource ResizeBorders}" MouseDown="ResizeBorder_MouseDown"/><Border x:Name="ResizeLeft" Width="6" HorizontalAlignment="Left" Cursor="SizeWE" Style="{StaticResource ResizeBorders}" MouseDown="ResizeBorder_MouseDown"/><Border x:Name="ResizeRight" Width="6" HorizontalAlignment="Right" Cursor="SizeWE" Style="{StaticResource ResizeBorders}" MouseDown="ResizeBorder_MouseDown"/><Border x:Name="ResizeTopLeft" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Style="{StaticResource ResizeBorders}" MouseDown="ResizeBorder_MouseDown"/><Border x:Name="ResizeTopRight" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Style="{StaticResource ResizeBorders}" MouseDown="ResizeBorder_MouseDown"/><Border x:Name="ResizeBottomLeft" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Style="{StaticResource ResizeBorders}" MouseDown="ResizeBorder_MouseDown"/><Border x:Name="ResizeBottomRight" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Style="{StaticResource ResizeBorders}" MouseDown="ResizeBorder_MouseDown"/>
  </Grid>
</Window>
