<Window x:Class="EVA_Catalogue.WindowSettingsModularCircuitBreakers" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:local="clr-namespace:EVA_Catalogue.ViewModels" Title="{Binding WindowTitle}" Width="700" Height="550" MinWidth="700" MinHeight="400" AllowsTransparency="True" Background="Transparent" FontFamily="{materialDesign:NotoFont}" ResizeMode="CanResize" TextElement.FontSize="14" WindowStartupLocation="CenterScreen" WindowStyle="None">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Dictionary.xaml"/></ResourceDictionary.MergedDictionaries><Style x:Key="AutomaticLightButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}"><Setter Property="Height" Value="34"/><Setter Property="Background" Value="LightGray"/><Setter Property="Foreground" Value="Black"/><Setter Property="BorderBrush" Value="Gray"/><Setter Property="BorderThickness" Value="1"/><Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="5"/></Style><Style x:Key="AutomaticDarkButton" TargetType="Button" BasedOn="{StaticResource GeneralButton}"><Setter Property="Height" Value="34"/><Setter Property="Background" Value="Gray"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="Gray"/><Setter Property="BorderThickness" Value="1"/></Style><Style x:Key="AutomaticArrowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="Black"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="Gray"/></Trigger></Style.Triggers></Style></ResourceDictionary></Window.Resources>
  <Window.DataContext><local:SettingsModularCircuitBreakersVM/></Window.DataContext>
  <Grid><Border Style="{StaticResource BorderWindow2}"><Grid><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="50"/><RowDefinition Height="40"/><RowDefinition/><RowDefinition Height="50"/><RowDefinition Height="40"/><RowDefinition/><RowDefinition Height="100"/></Grid.RowDefinitions>
    <Grid MouseDown="Window_MouseDown" Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Grid.ColumnSpan="3" Margin="10,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="Black" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"/><Button Grid.Column="2" Command="{Binding Cancel}" Style="{StaticResource CloseButtonStyle}"/></Grid>
    <Border Grid.Row="1" Margin="5" Background="Gray" Style="{StaticResource BorderWindow}"><TextBlock VerticalAlignment="Center" Foreground="White" Text="Выбор производителей"/></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Margin="10" Foreground="Black" Text="Доступные производители:"/><TextBlock Grid.Column="1" Margin="10" Foreground="Black" Text="Выбранные производители:"/></Grid>
